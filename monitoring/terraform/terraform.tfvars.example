# Project Configuration
project_name = "fastapi-monitoring"
environment  = "dev"
aws_region   = "ap-south-1"

# EC2 Configuration
instance_type    = "t3.medium"
key_pair_name    = "default"  # Replace with your actual key pair name

# Security Configuration
allowed_cidr_blocks = ["0.0.0.0/0"]  # Replace with your IP range for better security
