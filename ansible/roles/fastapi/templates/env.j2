# FastAPI Environment Configuration
# Generated by Ansible

# Compose Project Name
COMPOSE_PROJECT_NAME={{ app_name }}

# Database Configuration
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name }}
DB_PORT=5432

# API Configuration
API_HOST=0.0.0.0
API_PORT={{ app_port }}
API_WORKERS=4
DEBUG=false

# Security
SECRET_KEY={{ secret_key | default('IH6eTU59ilNk3Jen7MyChWLjHMrbtmQEEXHIk25CuBOGV5nuBH1p42C85bdLaC3z') }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=production
API_ENV=production

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
